{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Default credential storage relocation locations",
  "description": "Location metadata only; the credential document format is unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["predecessor", "successor", "documentFormatChanged"],
  "properties": {
    "predecessor": { "const": "$PANEDESK_HOME/.credentials.yaml" },
    "successor": { "const": "$PANEDESK_HOME/private/.credentials.yaml" },
    "documentFormatChanged": { "const": false }
  }
}
