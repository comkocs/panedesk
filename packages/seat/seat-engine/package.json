{
  "name": "@panedesk/dsh-seat-engine",
  "description": "Seat engine provider scaffold",
  "version": "2.0.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/seat/seat-engine"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./reader": {
      "types": "./lib/types/reader.d.ts",
      "default": "./lib/types/reader.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~"
  },
  "dependencies": {
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-jobs": "workspace:*",
    "@panedesk/dsh-subagent": "workspace:*",
    "@panedesk/dsh-schedule": "workspace:*",
    "@panedesk/dsh-message-delivery": "workspace:*",
    "@panedesk/dsh-llm-cache": "workspace:*",
    "@panedesk/dsh-seat": "workspace:*",
    "@panedesk/dsh-sdk-protocol": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@panedesk/dsh-home-paths": "workspace:*",
    "@panedesk/node-addon-system": "workspace:~"
  }
}
