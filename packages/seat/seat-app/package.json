{
  "name": "@panedesk/dsh-seat-app",
  "description": "Seat application consumer scaffold",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/seat/seat-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "dependencies": {
    "@panedesk/dsh-api-session-controller": "workspace:*",
    "@panedesk/dsh-client-connection": "workspace:*",
    "@panedesk/dsh-client-file-upload": "workspace:*",
    "@panedesk/dsh-workspace": "workspace:*",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@panedesk/dsh-schedule": "workspace:*",
    "@panedesk/dsh-seat": "workspace:*",
    "@panedesk/dsh-seat-engine": "workspace:*",
    "@panedesk/dsh-seat-gates": "workspace:*",
    "@panedesk/dsh-seat-local": "workspace:*",
    "@panedesk/dsh-seat-remote": "workspace:*",
    "@panedesk/dsh-tool-seat": "workspace:*"
  },
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-seat": "workspace:*",
    "@panedesk/dsh-sdk-protocol": "workspace:*",
    "@panedesk/dsh-cmdline": "workspace:*"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-seat": "workspace:*",
    "@panedesk/dsh-sdk-protocol": "workspace:*",
    "@panedesk/dsh-cmdline": "workspace:*"
  }
}
