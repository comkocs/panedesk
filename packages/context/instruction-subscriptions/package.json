{
  "name": "@panedesk/dsh-instruction-subscriptions",
  "description": "Bounded instruction change reminders before input claim",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/context/instruction-subscriptions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@panedesk/dsh-brand": "workspace:*",
    "@panedesk/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-fs": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-agent-instructions": "workspace:*",
    "@panedesk/dsh-message-delivery": "workspace:*"
  },
  "devDependencies": {
    "@panedesk/cordis-plugin-loader": "workspace:~",
    "@panedesk/cordis-plugin-include": "workspace:~",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-agent-loop-testkit": "workspace:*",
    "@panedesk/dsh-fs": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-tool-fs": "workspace:*",
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-agent-instructions": "workspace:*",
    "@panedesk/dsh-message-delivery": "workspace:*"
  }
}
