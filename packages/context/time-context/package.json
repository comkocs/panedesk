{
  "name": "@panedesk/dsh-time-context",
  "description": "Durable per-step context with the current time and elapsed time",
  "version": "1.9.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/context/time-context"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@panedesk/dsh-util-values": "workspace:*",
    "@panedesk/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-agent-loop": "workspace:*",
    "@panedesk/dsh-agent-loop-testkit": "workspace:*",
    "@panedesk/dsh-app-boot": "workspace:*",
    "@panedesk/dsh-bash-local": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-loader-smoke": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-checkpoint-policy": "workspace:*",
    "@panedesk/dsh-session-persistence-jsonl": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-subprocess-local": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*"
  }
}
