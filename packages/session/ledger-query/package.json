{
  "name": "@panedesk/dsh-ledger-query",
  "description": "Read-only ledger query and export service definitions",
  "version": "1.7.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/ledger-query"
  },
  "type": "module",
  "main": "lib/index.js",
