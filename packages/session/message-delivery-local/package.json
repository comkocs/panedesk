{
  "name": "@panedesk/dsh-message-delivery-local",
  "description": "Private local file mailboxes and lease-backed node registrations",
  "version": "1.9.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/message-delivery-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/files-*.js",
    "lib/windows-storage-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-message-delivery": "workspace:*"
  },
  "dependencies": {
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-home-paths": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@panedesk/dsh-session-persistence": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-session-projection-cache": "workspace:*",
    "@panedesk/dsh-session-title": "workspace:*",
    "@panedesk/dsh-subprocess": "workspace:*",
    "@panedesk/dsh-win32-process": "workspace:*",
    "@panedesk/dsh-workspace": "workspace:*",
    "@panedesk/node-addon-system": "workspace:~",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@panedesk/dsh-host-admin": "workspace:*",
    "@panedesk/dsh-node-link": "workspace:*",
    "@panedesk/dsh-seat": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.11",
    "@panedesk/cordis": "workspace:~",
    "@panedesk/cordis-plugin-include": "workspace:~",
    "@panedesk/cordis-plugin-loader": "workspace:~",
    "@panedesk/dsh-host-admin": "workspace:*",
    "@panedesk/dsh-node-link": "workspace:*",
    "@panedesk/dsh-message-delivery": "workspace:*",
    "@panedesk/dsh-seat": "workspace:*"
  }
}
