{
  "name": "@panedesk/dsh-session-log-deepseek",
  "description": "Incremental lossless session-log request extension for the official DeepSeek LLM API",
  "version": "1.3.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-log-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@panedesk/dsh-brand": "workspace:*",
    "@panedesk/dsh-util-values": "workspace:*",
    "@panedesk/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-deepseek-llm-api-extensions": "workspace:*",
    "@panedesk/dsh-session": "workspace:*"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/cordis-plugin-include": "workspace:~",
    "@panedesk/cordis-plugin-loader": "workspace:~",
    "@panedesk/dsh-command-feedback": "workspace:*",
    "@panedesk/dsh-deepseek-llm-api-extensions": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-llm-deepseek": "workspace:*",
    "@panedesk/dsh-llm-deepseek-api-key": "workspace:*",
    "@panedesk/dsh-llm-mock-server": "workspace:*",
    "@panedesk/dsh-message-feedback": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-persistence-jsonl": "workspace:*"
  }
}
