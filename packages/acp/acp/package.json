{
  "name": "@panedesk/dsh-acp",
  "description": "Automation-only Agent Client Protocol server for driving DeepSeek Harness agents over JSON-RPC stdio",
  "version": "1.8.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@panedesk/dsh-brand": "workspace:*",
    "@panedesk/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-attachment": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-mcp-client": "workspace:*",
    "@panedesk/dsh-message-delivery": "workspace:*",
    "@panedesk/dsh-sdk-jsonrpc-server": "workspace:*",
    "@panedesk/dsh-sdk-protocol": "workspace:*",
    "@panedesk/dsh-seat": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-persistence": "workspace:*",
    "@panedesk/dsh-token-meter": "workspace:*",
    "@panedesk/dsh-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@panedesk/dsh-seat": { "optional": true },
    "@panedesk/dsh-message-delivery": {
      "optional": true
    },
    "@panedesk/dsh-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/cordis-plugin-include": "workspace:~",
    "@panedesk/dsh-app-boot": "workspace:*",
    "@panedesk/dsh-cmdline": "workspace:*",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@panedesk/dsh-subagent-codex": "workspace:*",
    "@panedesk/dsh-subagent-dsh-sdk": "workspace:*",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-agent-loop": "workspace:*",
    "@panedesk/dsh-agent-loop-testkit": "workspace:*",
    "@panedesk/dsh-attachment": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-mcp-client": "workspace:*",
    "@panedesk/dsh-message-delivery": "workspace:*",
    "@panedesk/dsh-sdk-jsonrpc-server": "workspace:*",
    "@panedesk/dsh-sdk-protocol": "workspace:*",
    "@panedesk/dsh-seat": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-persistence": "workspace:*",
    "@panedesk/dsh-session-persistence-jsonl": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-subagent": "workspace:*",
    "@panedesk/dsh-token-meter": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-user-approval": "workspace:*"
  }
