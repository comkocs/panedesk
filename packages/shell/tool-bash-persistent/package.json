{
  "name": "@panedesk/dsh-tool-bash-persistent",
  "description": "Model-facing owner-scoped persistent Bash tool backed by the Harness PTY service",
  "version": "2.0.12",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/tool-bash-persistent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-output-retention": "workspace:*",
    "@panedesk/dsh-terminal": "workspace:*",
    "@panedesk/dsh-timeout": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-working-directory": "workspace:*"
  },
  "dependencies": {
    "@panedesk/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@panedesk/cordis-plugin-include": "workspace:~",
    "@panedesk/cordis-plugin-loader": "workspace:~",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-agent-loop-testkit": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-output-retention": "workspace:*",
    "@panedesk/dsh-terminal": "workspace:*",
    "@panedesk/dsh-terminal-bash": "workspace:*",
    "@panedesk/dsh-sandbox": "workspace:*",
    "@panedesk/dsh-sandbox-policy": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-subprocess-local": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-timeout": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-working-directory": "workspace:*"
  }
}
