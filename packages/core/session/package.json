{
  "name": "@panedesk/dsh-session",
  "description": "Event-sourced session store for the DeepSeek Harness",
  "version": "1.2.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/core/session"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./fork": {
      "types": "./lib/types/fork.d.ts",
      "default": "./lib/types/fork.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./surface": {
      "types": "./lib/types/surface.d.ts",
      "default": "./lib/types/surface.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/dsh-scope": "workspace:*",
    "@panedesk/cordis": "workspace:~"
  },
  "devDependencies": {
    "@panedesk/dsh-scope": "workspace:*",
    "@panedesk/dsh-typert-protocol": "workspace:*",
    "@panedesk/dsh-typert-registry": "workspace:*",
    "@panedesk/cordis": "workspace:~"
  },
  "dependencies": {
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-brand": "workspace:*",
    "@panedesk/dsh-util-values": "workspace:*"
  }
}
