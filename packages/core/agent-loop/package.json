{
  "name": "@panedesk/dsh-agent-loop",
  "description": "The concrete agent loop plugin for the DeepSeek Harness",
  "version": "1.8.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/core/agent-loop"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-scope": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@panedesk/dsh-session-persistence": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@panedesk/dsh-session-ledger": { "optional": true }
  },
  "dependencies": {
    "@panedesk/dsh-subprocess": "workspace:*",
    "@panedesk/dsh-launch-environment": "workspace:*",
    "@panedesk/dsh-brand": "workspace:*",
    "@panedesk/dsh-util-values": "workspace:*",
    "@panedesk/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@panedesk/dsh-llm-deepseek-api-key": "workspace:*",
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-llm-pi-ai": "workspace:*",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-scope": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@panedesk/dsh-session-persistence": "workspace:*",
    "@panedesk/dsh-session-persistence-jsonl": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*"
  }
}
