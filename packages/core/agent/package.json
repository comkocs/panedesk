{
  "name": "@panedesk/dsh-agent",
  "description": "Agent interface, registry, initiator scope, and event vocabulary for the DeepSeek Harness",
  "version": "2.0.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/core/agent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/dsh-brand": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-scope": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-typert-protocol": "workspace:*",
    "@panedesk/dsh-util-values": "workspace:*",
    "@panedesk/dsh-workspace": "workspace:*",
    "@panedesk/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@panedesk/dsh-workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@panedesk/dsh-brand": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-scope": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-typert-protocol": "workspace:*",
    "@panedesk/dsh-typert-registry": "workspace:*",
    "@panedesk/dsh-util-values": "workspace:*",
    "@panedesk/dsh-workspace": "workspace:*",
    "@panedesk/cordis": "workspace:~"
  }
}
