{
  "name": "@panedesk/dsh-ptc-runtime-node",
  "description": "Node PTC execution with per-call sandboxed processes or in-memory REPL state",
  "version": "1.5.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/ptc-runtime/ptc-runtime-node"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./process": {
      "types": "./lib/types/process-entry.d.ts",
      "default": "./lib/process.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/process.js",
    "lib/persistent-process.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-ptc-runtime": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-timeout": "workspace:*",
    "@panedesk/dsh-fs": "workspace:*",
    "@panedesk/dsh-subprocess": "workspace:*",
    "@panedesk/dsh-sandbox": "workspace:*",
    "@panedesk/dsh-sandbox-policy": "workspace:*"
  },
  "dependencies": {
    "@panedesk/dsh-util-values": "workspace:*",
    "@panedesk/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-ptc-runtime": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-timeout": "workspace:*",
    "@panedesk/dsh-fs": "workspace:*",
    "@panedesk/dsh-subprocess": "workspace:*",
    "@panedesk/dsh-sandbox": "workspace:*",
    "@panedesk/dsh-sandbox-policy": "workspace:*",
    "@panedesk/dsh-fs-local": "workspace:*",
    "@panedesk/dsh-subprocess-local": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-sandbox-local": "workspace:*"
  }
}
