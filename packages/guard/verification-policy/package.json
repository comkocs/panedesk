{
  "name": "@panedesk/dsh-verification-policy",
  "description": "Workspace verification switches enforced before native and programmatic tool execution",
  "version": "2.0.5",
  "type": "module",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/guard/verification-policy" },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./types": { "types": "./lib/types/types.d.ts" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts", "lib/typert.host.js", "lib/typert.host.d.ts", "lib/typert.remote-client.js", "lib/typert.remote-client.d.ts"],
  "license": "MIT",
  "peerDependencies": { "@panedesk/cordis": "workspace:~" },
  "dependencies": {
    "@panedesk/dsh-activity-category": "workspace:*",
    "@panedesk/dsh-storage-domain": "workspace:*",
    "@panedesk/dsh-timeout": "workspace:*",
    "@panedesk/dsh-typert-protocol": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-trace-store": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@panedesk/dsh-working-directory": "workspace:*",
    "@panedesk/dsh-workspace": "workspace:*"
  }
}
