{
  "name": "@panedesk/dsh-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process DeepSeek Harness SDK clients",
  "version": "2.0.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@panedesk/dsh-host-admin": "workspace:*",
    "@panedesk/dsh-brand": "workspace:*",
    "@panedesk/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-agent-preset-registry": "workspace:*",
    "@panedesk/dsh-attachment": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-llm-deepseek-api-key": "workspace:*",
    "@panedesk/dsh-scope": "workspace:*",
    "@panedesk/dsh-sdk-protocol": "workspace:*",
    "@panedesk/dsh-node-link": "workspace:*",
    "@panedesk/dsh-seat": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@panedesk/dsh-subagent": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-working-directory": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@panedesk/dsh-node-link": { "optional": true },
    "@panedesk/dsh-seat": { "optional": true },
    "@panedesk/dsh-session-ledger": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^4.1.11",
    "@panedesk/cordis": "workspace:~",
    "@panedesk/cordis-plugin-loader": "workspace:~",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-agent-preset-registry": "workspace:*",
    "@panedesk/dsh-agent-loop": "workspace:*",
    "@panedesk/dsh-agent-loop-testkit": "workspace:*",
    "@panedesk/dsh-attachment": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-llm-deepseek-api-key": "workspace:*",
    "@panedesk/dsh-scope": "workspace:*",
    "@panedesk/dsh-sdk-protocol": "workspace:*",
    "@panedesk/dsh-node-link": "workspace:*",
    "@panedesk/dsh-seat": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@panedesk/dsh-session-persistence-jsonl": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-subagent": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-working-directory": "workspace:*"
  }
}
