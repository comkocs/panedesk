{
  "name": "@panedesk/dsh-sdk-client",
  "description": "TypeScript client SDK for driving a DeepSeek Harness runtime subprocess over stdio JSON-RPC: the DeepSeekHarness high-level turns API and the lower-level HarnessClient",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "panedesk": "workspace:*"
  },
  "peerDependencies": {
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-sdk-protocol": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/cordis": "workspace:~"
  },
  "devDependencies": {
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-sdk-protocol": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-experimental-translator": "workspace:*"
  }
}
