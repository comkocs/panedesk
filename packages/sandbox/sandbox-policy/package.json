{
  "name": "@panedesk/dsh-sandbox-policy",
  "description": "Per-call sandbox policy resolver and current model context: deployment fallbacks plus each session's mode and workspace root, shared by every enforcing capability family",
  "version": "1.5.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sandbox/sandbox-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-sandbox": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-session-projection": "workspace:*"
  },
  "dependencies": {
    "@panedesk/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-sandbox": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-session-projection": "workspace:*"
  }
}
