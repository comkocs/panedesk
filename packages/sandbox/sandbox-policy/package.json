{
  "name": "@panedesk/dsh-sandbox-policy",
  "description": "Per-call sandbox policy resolver and current model context: deployment fallbacks plus each session's mode and workspace root, shared by every enforcing capability family",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sandbox/sandbox-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-sandbox": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-user-approval": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*"
  },
  "dependencies": {
    "@panedesk/dsh-atomic-write": "workspace:*",
    "@panedesk/dsh-home-paths": "workspace:*",
    "@panedesk/dsh-sandbox-windows-acl": "workspace:*",
    "@panedesk/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@panedesk/cordis-plugin-loader": "workspace:~",
    "@panedesk/dsh-app-boot": "workspace:*",
    "@panedesk/dsh-hmr": "workspace:*",
    "@panedesk/dsh-client-modules": "workspace:*",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-sandbox": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-user-approval": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*"
  }
}
