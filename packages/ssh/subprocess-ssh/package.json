{
  "name": "@panedesk/dsh-subprocess-ssh",
  "description": "Subprocess and terminal provider over the shared POSIX SSH helper",
  "version": "2.0.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/ssh/subprocess-ssh"
  },
  "type": "module",
  "main": "lib/index.js",
