    "@panedesk/dsh-subprocess-local": "workspace:*"
  },
  "dependencies": {
    "@panedesk/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-ssh": "workspace:*",
    "@panedesk/dsh-subprocess": "workspace:*",
    "@panedesk/dsh-subprocess-local": "workspace:*"
  }
