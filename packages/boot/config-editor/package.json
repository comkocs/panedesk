{
  "name": "@panedesk/dsh-config-editor",
  "description": "Persist plugin configuration through profile patches and Loader reconciliation",
  "version": "1.8.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/config-editor"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/cordis-plugin-loader": "workspace:~",
    "@panedesk/dsh-hmr": "workspace:*",
    "@panedesk/cordis-plugin-include": "workspace:~",
    "@panedesk/dsh-app-boot": "workspace:*"
  },
  "dependencies": {
    "@panedesk/dsh-atomic-write": "workspace:*",
    "yaml": "^2.8.1",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/cordis-plugin-loader": "workspace:~",
    "@panedesk/dsh-hmr": "workspace:*",
    "@panedesk/cordis-plugin-include": "workspace:~",
    "@types/js-yaml": "^4.0.9",
    "@panedesk/dsh-app-boot": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@panedesk/dsh-hmr": {
      "optional": true
    }
  }
}
