{
  "name": "@panedesk/dsh-db-connections",
  "description": "PostgreSQL connection catalog with credential storage and SSH forwarding",
  "version": "2.0.3",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./types": { "types": "./lib/types/types.d.ts" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts", "lib/typert.host.js", "lib/typert.host.d.ts", "lib/typert.remote-client.js", "lib/typert.remote-client.d.ts"],
  "peerDependencies": { "@panedesk/cordis": "workspace:~" },
  "devDependencies": { "@panedesk/cordis": "workspace:~", "@types/pg": "^8.15.5", "@types/ssh2": "^1.15.5" },
  "dependencies": {
    "@panedesk/schemastery": "workspace:~",
    "@panedesk/dsh-credentials": "workspace:*",
    "@panedesk/dsh-home-paths": "workspace:*",
    "@panedesk/dsh-atomic-write": "workspace:*",
    "@panedesk/dsh-typert-protocol": "workspace:*",
    "pg": "^8.16.3", "ssh2": "^1.17.0", "zod": "^4.4.3"
  }
}
