{
  "name": "@panedesk/dsh-webhook",
  "description": "Fire-and-forget webhook rule runtime that creates Workspace-backed DeepSeek Harness Sessions",
  "version": "1.7.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/webhook"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-agent-default-model": "workspace:*",
    "@panedesk/dsh-agent-preset-registry": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-permission-presets": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-title": "workspace:*",
    "@panedesk/dsh-workspace": "workspace:*"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/cordis-plugin-include": "workspace:~",
    "@panedesk/cordis-plugin-loader": "workspace:~",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-agent-default-model": "workspace:*",
    "@panedesk/dsh-agent-preset-registry": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-permission-presets": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-title": "workspace:*",
    "@panedesk/dsh-workspace": "workspace:*"
  },
  "dependencies": {
    "@panedesk/dsh-brand": "workspace:*",
    "@panedesk/dsh-util-values": "workspace:*"
  }
}
