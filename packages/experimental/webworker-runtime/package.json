{
  "name": "@panedesk/dsh-experimental-webworker-runtime",
  "description": "Browser-only harness runtime: in-memory VFS, module transform and loader, postMessage tunnel, and the dedicated Web Worker assembly, with the Node-compatibility layer that lets the host tree run unchanged",
  "version": "1.9.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/webworker-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./worker": "./lib/worker.js",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@panedesk/dsh-util-crypto": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "@yarnpkg/parsers": "^3.1.0",
    "acorn": "^8.18.0",
    "buffer": "^6.0.3",
    "picomatch": "^4.0.7",
    "readable-stream": "^4.7.0",
    "@panedesk/dsh-client-web": "workspace:*"
  },
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/cordis-plugin-loader": "workspace:~",
    "@panedesk/dsh-client-connection": "workspace:*",
    "@panedesk/dsh-client-modules": "workspace:*",
    "@panedesk/dsh-host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/cordis-plugin-loader": "workspace:~",
    "@panedesk/dsh-api-gateway": "workspace:*",
    "@panedesk/dsh-app-boot": "workspace:*",
    "@panedesk/dsh-bash-sandbox": "workspace:*",
    "@panedesk/dsh-client-connection": "workspace:*",
    "@panedesk/dsh-client-file-upload": "workspace:*",
    "@panedesk/dsh-client-modules": "workspace:*",
    "@panedesk/dsh-host-webserver": "workspace:*",
    "@panedesk/dsh-sandbox-local": "workspace:*",
    "@panedesk/dsh-sandbox-policy": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-session-persistence-jsonl": "workspace:*",
    "@panedesk/dsh-subagent": "workspace:*",
    "@panedesk/dsh-subprocess-local": "workspace:*",
    "@panedesk/node-addon-system": "workspace:~",
    "@types/picomatch": "^4.0.3",
    "@types/readable-stream": "^4.0.24",
    "chokidar": "5.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
