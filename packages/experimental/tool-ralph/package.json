{
  "name": "@panedesk/dsh-tool-ralph",
  "description": "Model-facing fresh-agent Ralph loop over the workflow and subagent seams",
  "version": "2.0.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/tool-ralph"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-subagent": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-workflow": "workspace:*",
    "@panedesk/cordis": "workspace:~"
  },
  "dependencies": {
    "@panedesk/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@panedesk/cordis-plugin-loader": "workspace:~",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-agent-loop": "workspace:*",
    "@panedesk/dsh-agent-loop-testkit": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-subagent": "workspace:*",
    "@panedesk/dsh-session-persistence-jsonl": "workspace:*",
    "@panedesk/dsh-subagent-spawn-in-process": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-workflow": "workspace:*",
    "@panedesk/dsh-workflow-ptc": "workspace:*",
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-session-projection": "workspace:*"
  }
}
