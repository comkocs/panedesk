{
  "name": "@panedesk/dsh-experimental-browser-use-playwright-mcp",
  "description": "Experimental per-Session Chromium browser tools through @playwright/mcp",
  "version": "2.0.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/browser-use-playwright-mcp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@panedesk/dsh-experimental-browser-use-runtime": "workspace:*",
    "@playwright/mcp": "0.0.80"
  },
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-browser-use": "workspace:*",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/cordis-plugin-loader": "workspace:~",
    "@panedesk/cordis-plugin-include": "workspace:~",
    "@panedesk/dsh-browser-use": "workspace:*",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-agent-loop": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-working-directory": "workspace:*"
  }
}
