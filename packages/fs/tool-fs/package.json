{
  "name": "@panedesk/dsh-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the DeepSeek Harness filesystem seam (ctx.fs)",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@panedesk/schemastery": "workspace:~",
    "@panedesk/dsh-util-code-language": "workspace:*"
  },
  "peerDependencies": {
    "@panedesk/dsh-attachment": "workspace:*",
    "@panedesk/dsh-fs": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-sandbox": "workspace:*",
    "@panedesk/dsh-sandbox-policy": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-user-approval": "workspace:*",
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-agent-loop": "workspace:*",
    "@panedesk/dsh-agent-loop-testkit": "workspace:*",
    "@panedesk/dsh-attachment": "workspace:*",
    "@panedesk/dsh-fs": "workspace:*",
    "@panedesk/dsh-fs-local": "workspace:*",
    "@panedesk/dsh-fs-observation-policy": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-llm-deepseek": "workspace:*",
    "@panedesk/dsh-llm-deepseek-api-key": "workspace:*",
    "@panedesk/dsh-sandbox": "workspace:*",
    "@panedesk/dsh-sandbox-policy": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-user-approval": "workspace:*",
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-scope": "workspace:*",
    "@panedesk/dsh-ptc-runtime": "workspace:*",
    "@panedesk/dsh-working-directory": "workspace:*"
  }
}
