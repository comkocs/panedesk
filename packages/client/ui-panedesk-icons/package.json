{
  "name": "@panedesk/dsh-client-ui-panedesk-icons",
  "description": "Panedesk entry glyphs and the shared design-token table the new panels consume: monoline current-color icons in 16/20/24 plus the spacing tier the upstream theme lacks",
  "version": "2.0.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-panedesk-icons"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tokens": {
      "types": "./lib/types/tokens.d.ts",
      "default": "./lib/types/tokens.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "scan:colors": "node scripts/scan-color-literals.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ]
}
