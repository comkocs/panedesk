{
  "name": "@panedesk/dsh-client-ui-plugin-market",
  "description": "Discover tab of the panedesk web Plugins page: browse configured plugin market indexes and install their bundles",
  "version": "1.9.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-plugin-market"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@panedesk/dsh-api-remotes",
        "@panedesk/dsh-client-locale",
        "@panedesk/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-api-remotes": "workspace:*",
    "@panedesk/dsh-client-locale": "workspace:*",
    "@panedesk/dsh-client-store": "workspace:*",
    "@panedesk/dsh-client-test-runtime": "workspace:*",
    "@panedesk/dsh-client-ui-plugin-manager": "workspace:*",
    "@panedesk/dsh-client-ui-primitives": "workspace:*",
    "@panedesk/dsh-client-ui-renderer": "workspace:*",
    "@panedesk/dsh-client-ui-slots": "workspace:*",
    "@panedesk/dsh-package-manifest": "workspace:*",
    "@panedesk/dsh-plugin-manager": "workspace:*",
    "@panedesk/dsh-plugin-market": "workspace:*",
    "@panedesk/dsh-plugin-market-index": "workspace:*",
    "@panedesk/dsh-typert-protocol": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
