{
  "name": "@panedesk/dsh-client-ui-seat-profiles",
  "description": "Owner-authorized seat profile editor and mapped table import",
  "version": "2.0.13",
  "type": "module",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/client/ui-seat-profiles" },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./types": { "types": "./lib/types/types.d.ts" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": { "client": { "platform": "web", "inject": ["@panedesk/dsh-api-remotes", "@panedesk/dsh-client-locale", "@panedesk/dsh-client-resources", "@panedesk/dsh-client-ui-settings"] } },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "license": "MIT",
  "peerDependencies": { "@panedesk/cordis": "workspace:~" },
  "dependencies": { "@panedesk/dsh-typert-protocol": "workspace:*", "zod": "^4.4.3" },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-client-ui-panedesk-icons": "workspace:*",
    "@panedesk/schemastery": "workspace:~",
    "@panedesk/dsh-api-remotes": "workspace:*",
    "@panedesk/dsh-client-locale": "workspace:*",
    "@panedesk/dsh-client-resources": "workspace:*",
    "@panedesk/dsh-client-store": "workspace:*",
    "@panedesk/dsh-client-ui-settings": "workspace:*",
    "@panedesk/dsh-client-ui-seats": "workspace:*",
    "@panedesk/dsh-client-ui-slots": "workspace:*",
    "@panedesk/dsh-client-ui-renderer": "workspace:*",
    "@panedesk/dsh-client-ui-primitives": "workspace:*",
    "@panedesk/dsh-client-test-runtime": "workspace:*",
    "@panedesk/dsh-api-gateway": "workspace:*",
    "@panedesk/dsh-client-connection": "workspace:*",
    "@panedesk/dsh-client-web": "workspace:*",
    "@panedesk/dsh-typert-registry": "workspace:*",
    "@panedesk/dsh-remote-mock": "workspace:*",
    "@panedesk/dsh-util-crypto": "workspace:*",
    "@panedesk/dsh-seat": "workspace:*",
    "@panedesk/dsh-seat-local": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.d.ts", "lib/typert.host.js", "lib/typert.host.d.ts", "lib/typert.remote-client.js", "lib/typert.remote-client.d.ts"]
}
