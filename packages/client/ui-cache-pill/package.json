{
  "name": "@panedesk/dsh-client-ui-cache-pill",
  "description": "Composer cache pill: remaining cache time for the window and its subagents, and an explicit-route tier switch that takes effect on the next request",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-cache-pill"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@panedesk/dsh-api-remotes",
        "@panedesk/dsh-client-locale",
        "@panedesk/dsh-client-ui-conversation",
        "@panedesk/dsh-client-ui-renderer",
        "@panedesk/dsh-client-resources"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-api-remotes": "workspace:*",
    "@panedesk/dsh-llm-cache": "workspace:*",
    "@panedesk/dsh-client-locale": "workspace:*",
    "@panedesk/dsh-client-test-runtime": "workspace:*",
    "@panedesk/dsh-client-ui-conversation": "workspace:*",
    "@panedesk/dsh-client-ui-primitives": "workspace:*",
    "@panedesk/dsh-client-ui-renderer": "workspace:*",
    "@panedesk/dsh-client-ui-slots": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@panedesk/dsh-client-resources": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
