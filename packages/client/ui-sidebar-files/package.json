{
  "name": "@panedesk/dsh-client-ui-sidebar-files",
  "description": "Workspace file tree tab type for the right Sidebar: lazy directory listing over the workspaceFiles Remote namespace, opening files into the Sidebar",
  "version": "2.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-sidebar-files"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@panedesk/dsh-api-workspace-files",
        "@panedesk/dsh-client-ui-sidebar-right",
        "@panedesk/dsh-client-ui-session",
        "@panedesk/dsh-api-remotes",
        "@panedesk/dsh-client-shortcuts"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-api-remotes": "workspace:*",
    "@panedesk/dsh-api-workspace-files": "workspace:*",
    "@panedesk/dsh-client-locale": "workspace:*",
    "@panedesk/dsh-client-store": "workspace:*",
    "@panedesk/dsh-client-test-runtime": "workspace:*",
    "@panedesk/dsh-client-ui-dockkit": "workspace:*",
    "@panedesk/dsh-client-ui-primitives": "workspace:*",
    "@panedesk/dsh-client-ui-renderer": "workspace:*",
    "@panedesk/dsh-client-ui-session": "workspace:*",
    "@panedesk/dsh-client-ui-sidebar-right": "workspace:*",
    "@panedesk/dsh-client-ui-slots": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-typert-protocol": "workspace:*",
    "@panedesk/dsh-util-workspace-path": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "clsx": "^2.0.0",
    "react-dom": "^18.2.0",
    "@panedesk/dsh-client-shortcuts": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
