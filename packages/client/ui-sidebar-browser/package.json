{
  "name": "@panedesk/dsh-client-ui-sidebar-browser",
  "description": "Sandboxed Web browser tabs for the right Sidebar",
  "version": "2.0.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-sidebar-browser"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@panedesk/dsh-api-workspace-controller",
        "@panedesk/dsh-client-ui-sidebar-right",
        "@panedesk/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-tools": "workspace:*"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-api-workspace-controller": "workspace:*",
    "@panedesk/dsh-brand": "workspace:*",
    "@panedesk/dsh-attachment": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-client-ui-workspace": "workspace:*",
    "@panedesk/dsh-client-ui-settings": "workspace:*",
    "@panedesk/dsh-client-locale": "workspace:*",
    "@panedesk/dsh-client-shortcuts": "workspace:*",
    "@panedesk/dsh-client-store": "workspace:*",
    "@panedesk/dsh-client-ui-conversation": "workspace:*",
    "@panedesk/dsh-client-ui-dockkit": "workspace:*",
    "@panedesk/dsh-client-ui-primitives": "workspace:*",
    "@panedesk/dsh-client-ui-renderer": "workspace:*",
    "@panedesk/dsh-client-ui-session": "workspace:*",
    "@panedesk/dsh-client-ui-sidebar-right": "workspace:*",
    "@panedesk/dsh-client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
