{
  "name": "@panedesk/dsh-client-ui-database-connections",
  "description": "Panedesk settings for PostgreSQL connections, SSL, SSH and credentials",
  "version": "1.4.0", "type": "module", "license": "MIT",
  "publishConfig": { "access": "public" },
  "main": "lib/index.js", "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*", "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/client.css", "lib/types/**/*.d.ts"],
  "dsh": { "client": { "platform": "web", "inject": ["@panedesk/dsh-api-remotes", "@panedesk/dsh-client-locale", "@panedesk/dsh-client-ui-renderer", "@panedesk/dsh-client-ui-settings"] } },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "peerDependencies": { "@panedesk/cordis": "workspace:~" },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~", "@panedesk/dsh-api-remotes": "workspace:*",
    "@panedesk/dsh-client-locale": "workspace:*", "@panedesk/dsh-client-store": "workspace:*",
    "@panedesk/dsh-client-ui-primitives": "workspace:*", "@panedesk/dsh-client-ui-renderer": "workspace:*",
    "@panedesk/dsh-client-ui-settings": "workspace:*", "@panedesk/dsh-client-ui-slots": "workspace:*",
    "@panedesk/dsh-db-connections": "workspace:*", "@panedesk/dsh-typert-protocol": "workspace:*",
    "react": "^18.2.0"
  }
}
