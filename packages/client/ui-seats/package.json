{
  "name": "@panedesk/dsh-client-ui-seats",
  "description": "Owner-authorized manual seat picker and existing-window browser",
  "version": "0.2.1-rc.2",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/client/ui-seats" },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types/types.js" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": { "client": { "platform": "web", "inject": ["@panedesk/dsh-api-remotes", "@panedesk/dsh-client-resources", "@panedesk/dsh-client-ui-conversation", "@panedesk/dsh-client-ui-sidebar", "@panedesk/dsh-client-ui-workspace"] } },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.js", "lib/types/**/*.d.ts", "lib/typert.host.js", "lib/typert.host.d.ts", "lib/typert.remote-client.js", "lib/typert.remote-client.d.ts"],
  "peerDependencies": { "@panedesk/cordis": "workspace:~", "@panedesk/dsh-typert-protocol": "workspace:*" },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-typert-protocol": "workspace:*",
    "@panedesk/dsh-seat": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-client-store": "workspace:*",
    "@panedesk/dsh-client-test-runtime": "workspace:*",
    "@panedesk/dsh-remote-mock": "workspace:*",
    "@panedesk/dsh-util-crypto": "workspace:*",
    "@panedesk/dsh-client-locale": "workspace:*",
    "@panedesk/dsh-client-resources": "workspace:*",
    "@panedesk/dsh-client-ui-slots": "workspace:*",
    "@panedesk/dsh-client-ui-primitives": "workspace:*",
    "@panedesk/dsh-client-ui-renderer": "workspace:*",
    "@panedesk/dsh-client-ui-conversation": "workspace:*",
    "@panedesk/dsh-client-ui-sidebar": "workspace:*",
    "@panedesk/dsh-client-ui-workspace": "workspace:*",
    "@panedesk/dsh-api-remotes": "workspace:*",
    "@panedesk/dsh-api-session-controller": "workspace:*",
    "react": "^18.2.0"
  }
}
