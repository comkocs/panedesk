{
  "name": "@panedesk/dsh-client-ui-verification-checklist",
  "description": "Right-sidebar verification checklist grouped by requirement",
  "version": "2.0.14",
  "type": "module",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/client/ui-verification-checklist" },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": { "client": { "platform": "web", "inject": ["@panedesk/dsh-api-gateway", "@panedesk/dsh-client-locale", "@panedesk/dsh-client-resources", "@panedesk/dsh-client-ui-sidebar-right", "@panedesk/dsh-client-ui-conversation", "@panedesk/dsh-client-ui-slots", "@panedesk/dsh-verification-policy"] } },
  "scripts": { "bundle": "tsdown" },
  "license": "MIT",
  "peerDependencies": { "@panedesk/cordis": "workspace:~" },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-activity-category": "workspace:*",
    "@panedesk/dsh-verification-policy": "workspace:*",
    "@panedesk/dsh-tool-verification-checklist": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-workspace": "workspace:*",
    "@panedesk/dsh-typert-protocol": "workspace:*",
    "@panedesk/dsh-api-gateway": "workspace:*",
    "@panedesk/dsh-api-workspace-controller": "workspace:*",
    "@panedesk/dsh-client-locale": "workspace:*",
    "@panedesk/dsh-client-resources": "workspace:*",
    "@panedesk/dsh-client-ui-slots": "workspace:*",
    "@panedesk/dsh-client-ui-renderer": "workspace:*",
    "@panedesk/dsh-client-ui-primitives": "workspace:*",
    "@panedesk/dsh-client-ui-conversation": "workspace:*",
    "@panedesk/dsh-client-ui-sidebar-right": "workspace:*",
    "@panedesk/dsh-client-ui-session": "workspace:*",
    "@panedesk/dsh-client-ui-settings-verification": "workspace:*",
    "@panedesk/dsh-client-ui-subagent-tree": "workspace:*",
    "react": "^18.2.0"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.d.ts"]
