{
  "name": "@panedesk/dsh-client-ui-subagent-tree",
  "description": "Owner-authorized read-only subagent parent-child tree with per-node monitoring",
  "version": "1.8.2",
  "type": "module",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/client/ui-subagent-tree" },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./types": { "types": "./lib/types/types.d.ts" },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": { "client": { "platform": "web", "inject": ["@panedesk/dsh-api-session-controller", "@panedesk/dsh-api-gateway", "@panedesk/dsh-client-locale", "@panedesk/dsh-client-resources", "@panedesk/dsh-client-ui-conversation", "@panedesk/dsh-client-ui-primitives", "@panedesk/dsh-client-ui-sidebar-right"] } },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "license": "MIT",
  "peerDependencies": { "@panedesk/cordis": "workspace:~" },
  "dependencies": { "@panedesk/dsh-typert-protocol": "workspace:*", "@panedesk/schemastery": "workspace:~", "zod": "^4.4.3" },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/cordis-plugin-loader": "workspace:~",
    "@panedesk/cordis-plugin-include": "workspace:~",
    "@panedesk/dsh-api-gateway": "workspace:*",
    "@panedesk/dsh-api-session-controller": "workspace:*",
    "@panedesk/dsh-client-locale": "workspace:*",
    "@panedesk/dsh-client-resources": "workspace:*",
    "@panedesk/dsh-client-ui-conversation": "workspace:*",
    "@panedesk/dsh-client-ui-panedesk-icons": "workspace:*",
    "@panedesk/dsh-client-ui-primitives": "workspace:*",
    "@panedesk/dsh-client-ui-renderer": "workspace:*",
    "@panedesk/dsh-client-ui-sidebar-right": "workspace:*",
    "@panedesk/dsh-client-ui-settings": "workspace:*",
    "@panedesk/dsh-settings": "workspace:*",
    "@panedesk/dsh-client-ui-slots": "workspace:*",
    "@panedesk/dsh-client-test-runtime": "workspace:*",
    "@panedesk/dsh-remote-mock": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@panedesk/dsh-session-query": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": ["locale/*.json", "lib/index.js", "lib/client.js", "lib/types/**/*.d.ts", "lib/typert.host.js", "lib/typert.host.d.ts", "lib/typert.remote-client.js", "lib/typert.remote-client.d.ts"]
}
