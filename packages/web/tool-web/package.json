{
  "name": "@panedesk/dsh-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the DeepSeek Harness web capability seam (ctx.web)",
  "version": "1.8.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-web": "workspace:*"
  },
  "dependencies": {
    "@panedesk/dsh-util-values": "workspace:*",
    "@panedesk/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-spill-local": "workspace:*",
    "@panedesk/dsh-spill-policy": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-tool-call-timeout-policy": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-web": "workspace:*",
    "@panedesk/dsh-web-fetch-http": "workspace:*",
    "@panedesk/dsh-web-search-exa": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@panedesk/dsh-scope": "workspace:*",
    "@panedesk/dsh-token-meter": "workspace:*"
  }
}
