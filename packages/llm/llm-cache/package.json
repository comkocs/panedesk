{
  "name": "@panedesk/dsh-llm-cache",
  "description": "Session cache policy and concurrency plugin scaffold",
  "version": "2.0.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-cache"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/view-types.d.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-typert-protocol": "workspace:*",
    "@panedesk/dsh-api-remote-access": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@panedesk/dsh-session-ledger": {
      "optional": true
    },
    "@panedesk/dsh-api-remote-access": {
      "optional": true
    }
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-agent-loop": "workspace:*",
    "@panedesk/dsh-time-context": "workspace:*",
    "@panedesk/dsh-typert-protocol": "workspace:*",
    "@panedesk/dsh-api-remote-access": "workspace:*",
    "@panedesk/dsh-api-gateway": "workspace:*",
    "@panedesk/dsh-client-connection": "workspace:*",
    "@panedesk/dsh-typert-registry": "workspace:*"
  },
  "dependencies": {
    "@panedesk/schemastery": "workspace:~"
  }
}
