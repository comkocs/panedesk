    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/dsh-storage": "workspace:*",
    "@panedesk/cordis": "workspace:~"
  },
  "dependencies": {
    "@panedesk/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@panedesk/dsh-storage": "workspace:*",
    "@panedesk/cordis": "workspace:~"
  }
}
