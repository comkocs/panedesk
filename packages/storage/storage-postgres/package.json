{
  "name": "@panedesk/dsh-storage-postgres",
  "description": "User-owned PostgreSQL storage with local fallback and a ledger mirror",
  "version": "1.8.6",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/storage/storage-postgres" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./types": { "types": "./lib/types/types.d.ts" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-storage": "workspace:*",
    "@panedesk/dsh-db-connections": "workspace:*",
    "@panedesk/dsh-session-ledger": "workspace:*"
  },
  "dependencies": {
    "@panedesk/schemastery": "workspace:~",
    "@panedesk/dsh-home-paths": "workspace:*",
    "@panedesk/dsh-atomic-write": "workspace:*",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-storage": "workspace:*",
    "@panedesk/dsh-db-connections": "workspace:*",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@types/pg": "^8.15.5"
  }
}
