{
  "name": "@panedesk/slim-base",
  "description": "Panedesk slim core as a profile bundle: a verbatim row subset of dsh-base (minimal headless core plus compaction, spill, timeout guard, AGENTS.md loading)",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/slim-base"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-agent-default-model": "workspace:*",
    "@panedesk/dsh-agent-instructions": "workspace:*",
    "@panedesk/dsh-agent-loop": "workspace:*",
    "@panedesk/dsh-bash-sandbox": "workspace:*",
    "@panedesk/dsh-compaction-basic": "workspace:*",
    "@panedesk/dsh-compaction-tool-result-pruner": "workspace:*",
    "@panedesk/dsh-fs-observation-policy": "workspace:*",
    "@panedesk/dsh-fs-sandbox": "workspace:*",
    "@panedesk/dsh-instruction-subscriptions": "workspace:*",
    "@panedesk/dsh-llm": "workspace:*",
    "@panedesk/dsh-llm-cache": "workspace:*",
    "@panedesk/dsh-llm-pi-ai": "workspace:*",
    "@panedesk/dsh-llm-retry": "workspace:*",
    "@panedesk/dsh-message-delivery-local": "workspace:*",
    "@panedesk/dsh-permission-presets": "workspace:*",
    "@panedesk/dsh-pwsh-sandbox": "workspace:*",
    "@panedesk/dsh-sandbox-local": "workspace:*",
    "@panedesk/dsh-sandbox-policy": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-checkpoint-policy": "workspace:*",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@panedesk/dsh-session-persistence-jsonl": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-shell-env": "workspace:*",
    "@panedesk/dsh-spill-local": "workspace:*",
    "@panedesk/dsh-spill-policy": "workspace:*",
    "@panedesk/dsh-subagent": "workspace:*",
    "@panedesk/dsh-subagent-spawn-in-process": "workspace:*",
    "@panedesk/dsh-subprocess-local": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-token-meter": "workspace:*",
    "@panedesk/dsh-tool-bash": "workspace:*",
    "@panedesk/dsh-tool-call-timeout-policy": "workspace:*",
    "@panedesk/dsh-tool-fs": "workspace:*",
    "@panedesk/dsh-tool-fs-search": "workspace:*",
    "@panedesk/dsh-tool-pwsh": "workspace:*",
    "@panedesk/dsh-tool-subagent": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-user-approval": "workspace:*",
    "@panedesk/dsh-working-directory": "workspace:*"
  },
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/cordis-plugin-include": "workspace:~",
    "@panedesk/cordis-plugin-loader": "workspace:~",
    "@panedesk/dsh-base": "workspace:*"
  }
}
