{
  "name": "@panedesk/dsh-ledger-app",
  "description": "Offline ledger application plugin scaffold",
  "version": "2.0.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/ledger-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "license": "MIT",
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@panedesk/dsh-ledger-query": "workspace:*",
    "@panedesk/dsh-ledger-watch": "workspace:*",
    "@panedesk/dsh-cmdline": "workspace:*"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@panedesk/dsh-ledger-query": "workspace:*",
    "@panedesk/dsh-ledger-watch": "workspace:*",
    "@panedesk/dsh-cmdline": "workspace:*"
  },
  "dependencies": {
    "@panedesk/dsh-app-boot": "workspace:*",
    "@panedesk/dsh-seat-engine": "workspace:*",
    "@panedesk/dsh-seat-gates": "workspace:*",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-session-projection": "workspace:*",
    "@panedesk/dsh-session-persistence-jsonl": "workspace:*",
    "@panedesk/dsh-message-delivery-local": "workspace:*",
    "@panedesk/dsh-session-ledger": "workspace:*",
    "@panedesk/dsh-ledger-query": "workspace:*",
    "@panedesk/schemastery": "workspace:~"
  }
}
