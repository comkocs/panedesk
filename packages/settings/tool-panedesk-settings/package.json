{
  "name": "@panedesk/dsh-tool-panedesk-settings",
  "description": "Read and update editable Panedesk preferences through the settings-page writer",
  "version": "2.0.9",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts"],
  "dependencies": {
    "@panedesk/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-tools": "workspace:*"
  },
  "devDependencies": {
    "@panedesk/cordis": "workspace:~",
    "@panedesk/dsh-agent": "workspace:*",
    "@panedesk/dsh-agent-preset-registry": "workspace:*",
    "@panedesk/dsh-session": "workspace:*",
    "@panedesk/dsh-system-prompt": "workspace:*",
    "@panedesk/dsh-tools": "workspace:*",
    "@panedesk/dsh-settings": "workspace:*",
    "@panedesk/dsh-config-editor": "workspace:*",
    "@panedesk/dsh-storage-postgres": "workspace:*"
  }
}
